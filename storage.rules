rules_version = '2';

/**
 * Catalog images: mobile app uploads to `businesses/{uid}/catalogItems/{itemId}/...`.
 * - Write: authenticated owner only, images only, max ~10 MB.
 * - Read: public so HTTPS download URLs work for WhatsApp / customers (tokens still gate access per object).
 */
service firebase.storage {
  match /b/{bucket}/o {
    match /businesses/{userId}/catalogItems/{itemId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
