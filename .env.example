OPENAI_API_KEY=sk-...
# Optional cap for WhatsApp replies (default 280). Short greetings use 150.
# OPENAI_MAX_REPLY_TOKENS=280
# Optional — overrides default chat model for generateReply + shouldReplyAI (default gpt-4o-mini).
# OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional — full system prompt for shouldReplyAI (YES/NO gate). If unset, uses src/config/defaults/shouldReplySystem.txt
# SHOULD_REPLY_AI_SYSTEM_PROMPT=
# Optional — path to UTF-8 file for should-reply system prompt (overrides default file when SHOULD_REPLY_AI_SYSTEM_PROMPT unset)
# SHOULD_REPLY_AI_SYSTEM_PROMPT_FILE=/absolute/or/relative/path.txt
# Optional — short noun for AI decision prompts: "Current {label}:" (default item). Examples: item, vehicle, product, SKU
# EMILY_CONTEXT_LABEL=item
# Optional — fallback assistant text when model returns empty for pricing/duration intent (or set EMILY_FALLBACK_PRICING_REPLY_FILE)
# EMILY_FALLBACK_PRICING_REPLY=
# EMILY_FALLBACK_PRICING_REPLY_FILE=
# Optional — comma-separated keywords for Playwright business-chat hint (overrides src/config/defaults/businessKeywords.txt)
# PLAYWRIGHT_BUSINESS_KEYWORDS=civic,corolla,car,rent
# Optional — comma-separated open-chat titles (normalized) that may run extraction + AI; overrides src/config/defaults/playwrightAllowedChats.txt. Omit both env and file to allow any chat title.
# PLAYWRIGHT_ALLOWED_CHAT_TITLES=Leads,Car Rental Queries
PORT=3000

# Production: keep false or unset. If true, group keyword gate is bypassed and the buffer logs "group gate skipped" — AI may reply to every group message.
# WHATSAPP_GROUP_DEBUG=false
# Production: keep false or unset. If true, group gate evaluation is skipped entirely.
# WHATSAPP_GROUP_GATE_DISABLED=false

# --- Shared WhatsApp Cloud API (one Emily number for all users) — required for outbound replies
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token

# --- WhatsApp webhook (GET /webhook) — must match Meta → WhatsApp → Configuration → Verify token
# META_WEBHOOK_VERIFY_TOKEN=your_verify_token

# --- WhatsApp onboarding (manual phone in app; Meta OAuth routes disabled on server)
# Optional legacy Meta vars if you re-enable OAuth elsewhere:
# META_APP_ID=
# META_APP_SECRET=
# META_OAUTH_REDIRECT_URI=https://YOUR_PUBLIC_HOST/api/whatsapp/connect/callback
# Admin: POST /api/whatsapp/manual-connect/confirm with Authorization: Bearer <secret>
# MANUAL_CONNECT_CONFIRM_SECRET=your_long_random_secret

# When inbound webhook metadata phone_number_id matches WHATSAPP_PHONE_NUMBER_ID but no owner is found in Firestore, set this to the Firebase Auth uid used as businesses/{uid}:
# LEGACY_BUSINESS_FIREBASE_UID=your_firebase_auth_uid_here

# --- Mobile app (Expo) — optional here if you use a single root .env; or set in mobile-app/.env
# Firebase Console → Project settings → Your apps → Web app
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional — protect POST /save-knowledge (Bearer or x-api-key header)
# SAVE_KNOWLEDGE_SECRET=your-secret

# Optional — GET /admin/flagged-messages (Bearer token must match)
# EMILY_ADMIN_FLAGGED_MESSAGES_SECRET=your-secret

# Optional — default `channel` on message logs when unset (legacy rows use this when reading)
# EMILY_DEFAULT_MESSAGE_CHANNEL=whatsapp

# Optional — Open-Meteo weather (defaults ~ Lahore if unset)
# WEATHER_LAT=31.5204
# WEATHER_LON=74.3587

# --- Optional: Playwright WhatsApp Web group listener (does not replace Meta webhook)
# PLAYWRIGHT_ENABLED=true
# PLAYWRIGHT_GROUP_NAME=Car Rental Queries
# PLAYWRIGHT_GROUPS=Group 1,Group 2,Group 3   # optional; comma-separated (overrides single name for filtering)
# PLAYWRIGHT_OWNER_USER_ID=your_firebase_auth_uid  # or rely on LEGACY_BUSINESS_FIREBASE_UID / WHATSAPP_GROUP_FALLBACK_OWNER_UID
# Group / DM JID for outbound replies is read from WhatsApp Web DOM (data-id); no env group id needed
# PLAYWRIGHT_SESSION_KEY=  # optional override; default owner::playwright-<hash>
# PLAYWRIGHT_QR_TIMEOUT_MS=600000
# PLAYWRIGHT_DEBUG=1   # verbose poll / dedupe logs (default off)
# PLAYWRIGHT_CHAT_LOOP=false   # set to disable sidebar rotation (unread-first, 8s); default on
# PLAYWRIGHT_REPLY_PRIVATELY_ENABLED=true   # owner approval opens customer DM via WhatsApp Web Reply privately
# PLAYWRIGHT_CHAT_OPEN_TIMEOUT_MS=5000   # per-step timeout: header match, #main, panel (after sidebar click)
# PLAYWRIGHT_POLL_INTERVAL_MS=4000   # background poll (default 4s; increase if polls race chat load)
# PLAYWRIGHT_NO_SEND=false   # local diagnostics only: log would-send events but do not type, press Enter, or upload media
# Chat loop interval is 8s when enabled (see listener.js)
# Narrow availability customer DM confirm poller (NOT broad DM continuation; keep PLAYWRIGHT_DM_CONTINUATION_ENABLED unset/false)
# PLAYWRIGHT_AVAILABILITY_CUSTOMER_CONFIRM_POLLER_ENABLED=false
# PLAYWRIGHT_AVAILABILITY_CUSTOMER_CONFIRM_POLLER_INTERVAL_MS=12000  # clamp 5000–60000; auto tick limit is always 1
# PLAYWRIGHT_AVAILABILITY_CUSTOMER_CONFIRM_MANUAL_TRIGGER_ENABLED=false  # POST /internal/poll-availability-customer-confirm
# Group Contact-info customer phone extraction (no DM send; default off)
# PLAYWRIGHT_GROUP_CONTACT_PHONE_EXTRACTION_ENABLED=false
# PLAYWRIGHT_GROUP_CONTACT_PHONE_EXTRACTION_INTERVAL_MS=15000  # clamp 5000–60000; auto tick limit is always 1


